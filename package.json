{
  "name": "studia",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" run dev",
    "build": "pnpm --filter @studia/web run build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "eval": "vitest run --config vitest.eval.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r run typecheck",
    "lint": "eslint . --max-warnings=0 && pnpm run lint:boundaries",
    "lint:boundaries": "depcruise --config .dependency-cruiser.cjs apps/*/src packages/*/src",
    "db:generate": "pnpm --filter @studia/api run db:generate",
    "users:create": "pnpm --filter @studia/api run users:create"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@playwright/test": "^1.49.1",
    "@studia/core": "workspace:*",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.10",
    "better-sqlite3": "^11.8.1",
    "dependency-cruiser": "^16.9.0",
    "drizzle-orm": "^0.38.4",
    "eslint": "^9.19.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.22.0",
    "vitest": "^3.0.4"
  }
}
